# Demo content for the quick start's OpenLDAP, applied once, on the first start of an empty
# directory. Every password is "Axia-Demo-1". This directory is for trying the console out: its
# ports are not published, and the console is bound to localhost only.
#
# The role groups are written in two shapes on purpose — groupOfNames and groupOfUniqueNames —
# because directories use both, and this image's memberof overlay only covers the second.

dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people
description: Accounts

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups
description: Groups, including the ones mapped to the console's roles

dn: ou=staff,ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: staff
description: Ordinary employees

# --- People who sign in to the console ---------------------------------------------------------

dn: uid=admin.demo,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: admin.demo
cn: Aigerim Admin
sn: Admin
givenName: Aigerim
displayName: Aigerim Admin
mail: admin.demo@example.org
userPassword: Axia-Demo-1

