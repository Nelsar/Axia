# --- Groups mapped to roles in docker-compose.yml ------------------------------------------------

dn: cn=axia-admins,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: axia-admins
description: Admin in the console. Also a protected group: only an Admin can change its members.
member: uid=admin.demo,ou=people,dc=example,dc=org

dn: cn=axia-creators,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: axia-creators
description: UserCreator in the console
uniqueMember: uid=creator.demo,ou=people,dc=example,dc=org

dn: cn=axia-editors,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: axia-editors
description: UserEditor in the console
member: uid=editor.demo,ou=people,dc=example,dc=org

dn: cn=engineering,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: engineering
description: An ordinary group, mapped to nothing
member: uid=ivan.petrov,ou=staff,ou=people,dc=example,dc=org
member: uid=john.smith,ou=staff,ou=people,dc=example,dc=org
