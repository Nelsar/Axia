# --- Groups mapped to nothing -------------------------------------------------------------------

dn: cn=sales,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: sales
description: Sales department
member: uid=daniyar.omarov,ou=sales,ou=staff,ou=people,dc=example,dc=org
member: uid=olga.sidorova,ou=sales,ou=staff,ou=people,dc=example,dc=org
member: uid=asel.karimova,ou=sales,ou=staff,ou=people,dc=example,dc=org

dn: cn=it-staff,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: it-staff
description: IT department
uniqueMember: uid=timur.akhmetov,ou=it,ou=staff,ou=people,dc=example,dc=org
uniqueMember: uid=saule.bekova,ou=it,ou=staff,ou=people,dc=example,dc=org

dn: cn=developers,ou=groups,dc=example,dc=org
objectClass: posixGroup
cn: developers
description: Membership by login (memberUid), the posixGroup way
gidNumber: 10000
memberUid: timur.akhmetov
memberUid: saule.bekova

# Nested: its members include a group. Nested groups are not followed, so the people in "sales"
# are not members of this one as far as the API is concerned.
dn: cn=all-staff,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: all-staff
description: Everyone directly listed, plus the sales group as a nested member
member: uid=ivan.petrov,ou=staff,ou=people,dc=example,dc=org
member: uid=john.smith,ou=staff,ou=people,dc=example,dc=org
member: uid=timur.akhmetov,ou=it,ou=staff,ou=people,dc=example,dc=org
member: cn=sales,ou=groups,dc=example,dc=org

dn: cn=contractors,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: contractors
description: External contractors
member: uid=peter.mueller,ou=contractors,ou=people,dc=example,dc=org
member: uid=temp.intern,ou=contractors,ou=people,dc=example,dc=org
