# Test data on top of the quick start's demo content (../quickstart/bootstrap.ldif), applied after
# it on the first start of an empty directory. Every password is "Axia-Demo-1".
#
# What it adds: the fourth role (UserDeleter), more units to browse and move accounts between,
# accounts in several groups at once, and the group shapes the API reads membership from but the
# demo leaves out — posixGroup by memberUid, and a nested group, which is deliberately not followed.

# --- The one role the demo has no group for ------------------------------------------------------

dn: uid=deleter.demo,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: deleter.demo
cn: Dana Deleter
sn: Deleter
givenName: Dana
displayName: Dana Deleter
mail: deleter.demo@example.org
userPassword: Axia-Demo-1

dn: cn=axia-deleters,ou=groups,dc=example,dc=org
objectClass: groupOfNames
cn: axia-deleters
description: UserDeleter in the console
member: uid=deleter.demo,ou=people,dc=example,dc=org

# --- Units --------------------------------------------------------------------------------------

dn: ou=it,ou=staff,ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: it
description: IT department

dn: ou=sales,ou=staff,ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: sales
description: Sales department

dn: ou=contractors,ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: contractors
description: External contractors

