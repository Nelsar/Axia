<!--
  The Windows installer: Nelsar.Axia-<version>-<x64|arm64>.msi, a per-machine install of the API,
  with the console it serves, as a Windows service. See docs/installation-windows.md for what it
  does and docs/development.md for how to build it.

  It packages a self-contained publish of the API made beforehand, with the console in its
  wwwroot, and is not part of Nelsar.Axia.sln: it builds on Windows only, and the solution builds
  everywhere. WiX 5, not 6 or later: those come with a maintenance fee and a EULA to accept on
  every build, and nothing used here needs them.
-->
<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>Nelsar.Axia-$(Version)-$(Platform)</OutputName>
    <!-- A folder of its own for each version. WiX decides whether to bind again from the tracking
         file the last bind left in this folder, not from the output name, so a second version built
         into the same folder — CI builds 0.0.1 after the real one, to upgrade from — found nothing
         to do and then failed to copy an .msi that was never made (MSB3030). -->
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\$(Version)\</IntermediateOutputPath>
    <!-- Given on the command line, relative to where the build is run from. -->
    <_AxiaPublishDir Condition="'$(AxiaPublishDir)' != ''">$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(AxiaPublishDir)'))))</_AxiaPublishDir>
    <!-- ICE60 asks for a language on every versioned file that is not a font. The .NET runtime's
         files carry versions and no language, and Windows Installer copes; there is nothing to fix. -->
    <SuppressIces>ICE60</SuppressIces>
    <DefineConstants>Version=$(Version);PublishDir=$(_AxiaPublishDir)</DefineConstants>
  </PropertyGroup>

  <!-- Both are easy to leave out, and either left out builds something wrong rather than nothing:
       an x86 package of 64-bit binaries, or one with no binaries at all. -->
  <Target Name="AxiaCheckInputs" BeforeTargets="Build">
    <Error Condition="'$(Platform)' != 'x64' and '$(Platform)' != 'arm64'"
           Text="Build with -p:Platform=x64 or -p:Platform=arm64, matching the runtime the API was published for." />
    <Error Condition="'$(_AxiaPublishDir)' == '' or !Exists('$(_AxiaPublishDir)Nelsar.Axia.Api.exe')"
           Text="Set -p:AxiaPublishDir to a self-contained publish of the API for win-$(Platform); see docs/development.md." />
    <Error Condition="!Exists('$(_AxiaPublishDir)wwwroot/index.html')"
           Text="$(_AxiaPublishDir) has no console in wwwroot. Publish the API with -p:AxiaConsoleDist; see docs/development.md." />
  </Target>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
