# Optional settings for the quick start (docker-compose.yml). Nothing here is required: without a
# .env, Compose uses the defaults below. To change one, copy this file and edit the copy, which is
# git-ignored:
#
#   cp .env.example .env
#
# The API's signing and encryption keys are not here on purpose. The quick start generates them
# on the first start, into a Docker volume; see deploy/quickstart/init.sh.

# The directory administrator's password, which the API also binds with. The directory is reachable
# only inside the Compose network. It is set when the directory is first created, so changing it
# afterwards needs a fresh directory: `docker compose down -v`.
LDAP_ADMIN_PASSWORD=quickstart-admin

# The port the console is served on, on localhost only.
CONSOLE_PORT=8080
