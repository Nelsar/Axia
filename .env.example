# Copy to .env (git-ignored) and adjust as needed: `cp .env.example .env`
# docker-compose reads this automatically.

# --- OpenLDAP container bootstrap ---
LDAP_ORGANISATION=Nelsar
LDAP_DOMAIN=nelsar.kz
LDAP_ADMIN_PASSWORD=password@

# --- API's Ldap:* config (points at the openldap service above by default) ---
# ProviderType MUST stay StandardLdap even when pointing at real Active Directory:
# ActiveDirectoryProvider uses System.DirectoryServices, which is Windows-only and will
# throw PlatformNotSupportedException in this Linux container. StandardLdapProvider talks
# to AD/OpenLDAP/eDirectory alike over plain LDAP (see StandardLdapProvider.cs doc comment).
LDAP_SERVER=openldap
LDAP_PORT=389
LDAP_BASE_DN=dc=nelsar,dc=kz
LDAP_ADMIN_USERNAME=cn=admin,dc=nelsar,dc=kz
LDAP_PROVIDER_TYPE=StandardLdap

# --- Where the log goes ---
# Console (JSON) and a rolling JSON file are on by default and need nothing here. The two
# shippers are switches: set Enabled and an address, and the sink appears at the next start.
# More than one may be on at once, and keeping the file sink under a shipper is what gives you
# something to read when the shipper itself is down.
#
# ELK — point at a Logstash `http` input (input { http { port => 8080 codec => json } }):
# OBSERVABILITY_LOGSTASH_ENABLED=true
# OBSERVABILITY_LOGSTASH_URI=http://logstash:8080
#
# Grafana Loki — base URI only; the sink appends /loki/api/v1/push:
# OBSERVABILITY_LOKI_ENABLED=true
# OBSERVABILITY_LOKI_URI=http://loki:3100
# Only for a Loki behind a gateway. Keep it here, in the git-ignored .env, never in appsettings:
# OBSERVABILITY_LOKI_PASSWORD=

# --- To test against real Active Directory instead, override these in .env: ---
# LDAP_SERVER=dc01.corp.example.com
# LDAP_PORT=389
# LDAP_BASE_DN=dc=corp,dc=example,dc=com
# LDAP_ADMIN_USERNAME=svc-ldap@corp.example.com
# LDAP_ADMIN_PASSWORD=<real-password>
# LDAP_PROVIDER_TYPE=StandardLdap
# The container must be able to reach the AD host on the network (VPN/routing), and
# LDAP_ADMIN_PASSWORD above is reused for both openldap bootstrap and Ldap:AdminPassword —
# when pointing at real AD, that shared value becomes your AD admin bind password.
