{
    // Levels only. Which sinks the log reaches lives under "Observability" below — see the note
    // there. Anything Serilog documents for this section (Filter, Destructure, a WriteTo array)
    // is still read, so the standard configuration route stays open for cases the switches
    // below do not cover.
    //
    // The three overrides below are also the built-in defaults, so an instance configured only
    // through the environment gets them too. They are spelled out so that turning one back up
    // to Information is an edit here rather than something to look up.
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                // Every SQL statement EF Core runs is logged at Information, parameters included
                // once anyone turns on EnableSensitiveDataLogging. Directory bind DNs and the
                // encrypted secrets column both travel through those statements.
                "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
                "System.Net.Http.HttpClient": "Warning"
            }
        }
    },

    // Where the log goes. Console and file are on; the two shippers are switches, so moving to
    // ELK or Grafana is a flag and an address rather than a code change:
    //
    //   Observability__Logstash__Enabled=true   Observability__Logstash__Uri=http://logstash:8080
    //   Observability__Loki__Enabled=true       Observability__Loki__Uri=http://loki:3100
    //
    // More than one may be on at a time — the file sink is worth keeping under a shipper, since
    // it is what survives the shipper being down.
    "Observability": {
        "ApplicationName": "Nelsar.Axia.Api",

        // Json=false swaps the compact JSON for a readable line. Leave it true anywhere a
        // collector reads stdout (Docker's json-file driver, Filebeat, Promtail).
        "Console": {
            "Enabled": true,
            "Json": true
        },

        // Compact JSON, one file per day. This is the ELK path that needs nothing of the
        // application: Filebeat tails the directory and Logstash never hears from the process.
        // Mount this path in a container or the log dies with it.
        "File": {
            "Enabled": true,
            "Path": "logs/axia-.json",
            "RetainedFileCountLimit": 14
        },

        // Logstash's HTTP input:
        //   input { http { port => 8080 codec => json } }
        // The sink batches and buffers in memory, dropping the oldest events rather than
        // blocking, so an unreachable Logstash cannot slow the API down.
        "Logstash": {
            "Enabled": false,
            "Uri": "http://logstash:8080",
            "QueueLimitBytes": 33554432,
            "PeriodSeconds": 2
        },

        // Grafana Loki's base URI — the sink appends /loki/api/v1/push itself.
        // Labels are indexed, so they stay few and low-cardinality: nothing per-request belongs
        // in here. Username/Password are for a Loki behind a gateway; supply them through the
        // environment (Observability__Loki__Password), never in this file.
        "Loki": {
            "Enabled": false,
            "Uri": "http://loki:3100",
            "Labels": {
                "app": "nelsar-axia",
                "component": "api"
            }
        },

        "Correlation": {
            "HeaderName": "X-Correlation-ID"
        }
    },

    // Whether an unauthenticated caller may create a directory account through
    // POST /api/v1/auth/register. Off, and worth leaving off: that endpoint writes to the directory
    // with nothing but a rate limiter in front of it. Administrators create accounts through
    // POST /api/v1/users, behind the users.create permission, which is the same operation.
    "Auth": {
        "AllowSelfRegistration": false
    },

    // Which websites may call this API from a browser. Empty means loopback only, which is
    // what development needs and what keeps an exposed port from becoming an open API. Name
    // the console's own origin when it is hosted anywhere else; naming any origin replaces the
    // loopback default rather than adding to it.
    //
    //   "AllowedOrigins": [ "https://axia.example.com" ]
    //
    // This decides which pages may read a response in a browser. It is not a network control
    // and does not restrain a non-browser client.
    "Cors": {
        "AllowedOrigins": []
    },

    // Off, because the usual deployment has a reverse proxy terminating TLS and speaking plain
    // HTTP to this process — redirecting there bounces the proxy's own request back at it. Turn
    // it on when the API itself holds the certificate. HSTS is sent outside Development either
    // way.
    "Https": {
        "RedirectToHttps": false
    },

    // X-Forwarded-For is a header anyone who can reach the port may send, and the rate limiter
    // partitions by client address — so forwarded headers are believed only from the proxies
    // named here. Until one is named, every request appears to come from the proxy: a single
    // rate-limit bucket, and the proxy's address in the audit trail.
    //
    //   "KnownProxies": [ "10.0.0.7" ]        individual addresses
    //   "KnownNetworks": [ "10.0.0.0/8" ]     CIDR ranges
    "ReverseProxy": {
        "KnownProxies": [],
        "KnownNetworks": []
    },

    "Ldap": {
        "Server": "openldap",
        "Port": 389,
        "BaseDn": "dc=nelsar,dc=kz",
        "AdminUsername": "cn=admin,dc=nelsar,dc=kz",
        "AdminPassword": "CHANGE_ME",
        "UserSearchFilter": "(&(objectClass=person)(|(uid={0})(sAMAccountName={0})(userPrincipalName={0})(mail={0})))",
        "ProviderType": "StandardLdap"
    },
    "Jwt": {
        "Key": "CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG",
        "Issuer": "Nelsar.Axia.Api",
        "Audience": "Nelsar.Axia.Api",
        "ExpiresInMinutes": 60
    },
    "AllowedHosts": "*"
}
