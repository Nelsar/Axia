<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Most actions don't have (and don't need) XML doc comments; only suppress the
         "missing XML comment" warning, not other analyzers. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.Grafana.Loki" Version="9.0.2" />
    <PackageReference Include="Serilog.Sinks.Http" Version="9.2.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.21.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The file sink writes to logs/ under the working directory, which is this folder when the
         API is started from an IDE, and the Web SDK publishes every .json it finds here. Without
         this the next publish ships the log files — masked logins, DNs, request paths — next to
         the binaries. -->
    <Content Remove="logs/**" />
  </ItemGroup>

  <!-- The built console, published next to the binaries as wwwroot, where the API finds and serves
       it (see ConsoleOptions). Only when asked for — an installer's build, not the container
       image's, whose console nginx serves:

         VITE_API_SAME_ORIGIN=true npm run build    (in frontend/)
         dotnet publish Nelsar.Axia.Api -c Release -p:AxiaConsoleDist=../frontend/dist

       Built beforehand rather than here, so that building the API never needs Node. -->
  <ItemGroup Condition="'$(AxiaConsoleDist)' != ''">
    <ResolvedFileToPublish Include="$([MSBuild]::EnsureTrailingSlash('$(AxiaConsoleDist)'))**"
                           RelativePath="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
                           CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nelsar.Axia.Infrastructure/Nelsar.Axia.Infrastructure.csproj" />
    <ProjectReference Include="../Nelsar.Axia.Contracts/Nelsar.Axia.Contracts.csproj" />
    <!-- Nothing here calls into these; EF Core loads whichever one Database:Provider names, by
         assembly name. Referenced so that both are built and published with the API. -->
    <ProjectReference Include="../Nelsar.Axia.Migrations.PostgreSql/Nelsar.Axia.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="../Nelsar.Axia.Migrations.Sqlite/Nelsar.Axia.Migrations.Sqlite.csproj" />
  </ItemGroup>

</Project>
