<Project Sdk="Microsoft.NET.Sdk">

  <!-- The schema's history on SQLite, from the first release on. Each database the application
       can use keeps its migrations in a project of its own, because a migration is SQL for one
       engine: one set cannot serve two. Selected by AxiaDatabase; adding a migration is described
       in CONTRIBUTING.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- For `dotnet ef`, which runs this project as its startup project; see
         DesignTimeContextFactory. Nothing of it is shipped. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Nelsar.Axia.Infrastructure/Nelsar.Axia.Infrastructure.csproj" />
  </ItemGroup>

</Project>
