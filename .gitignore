# ---------------------------------------------------------------------------
# Secrets. Nothing here is an inconvenience to work around — a file matched by
# this section holds a live credential, and the .example counterpart next to it
# is the one that belongs in the repository.
# ---------------------------------------------------------------------------

# docker-compose secrets.
.env

# Local .NET secrets: the LDAP bind password, the JWT signing key, the AES key
# used for provider passwords at rest. Copy the example and fill in real values:
#   cp Nelsar.Axia.Api/appsettings.json.example Nelsar.Axia.Api/appsettings.json
#   cp Nelsar.Axia.Api/appsettings.Development.json.example Nelsar.Axia.Api/appsettings.Development.json
Nelsar.Axia.Api/appsettings*.json
!Nelsar.Axia.Api/appsettings*.json.example

# ---------------------------------------------------------------------------
# Build output. None of this is source: it is regenerated by `dotnet build` and
# `npm run build`, it differs per machine, and it is what turned a repository of
# roughly a megabyte of source into a 58 MB clone.
# ---------------------------------------------------------------------------

# .NET
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userprefs
artifacts/

# The Chocolatey package, built by `choco pack` in deploy/chocolatey.
*.nupkg

# Node / Vite
node_modules/
dist/

# ---------------------------------------------------------------------------
# Local state: databases, logs, and whatever an editor keeps for itself.
# ---------------------------------------------------------------------------

# SQLite files created on first run by DbInitializer.
*.db
*.db-shm
*.db-wal

# The Serilog file sink's default destination. These carry masked logins, DNs and
# request paths — logs, not source.
logs/

# Editors and IDEs.
.vs/
.idea/
.vscode/
*.swp
.DS_Store

# Python virtualenvs that ended up here by accident.
.venv/
.venv-*/

# Tooling. launch.json describes how to start the dev server and is worth sharing;
# settings.local.json is one developer's own tool permissions, and the worktrees are scratch.
.claude/settings.local.json
.claude/worktrees/
