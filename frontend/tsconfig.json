{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": [],

    "strict": true,
    /* Indexing an array yields T | undefined, so `items[0].name` no longer compiles unchecked.
       For a console whose whole job is rendering directory responses — lists that are routinely
       empty — this is the case the flag exists for. */
    "noUncheckedIndexedAccess": true,
    /* `style?: CSSProperties` and `style: CSSProperties | undefined` are different types: without
       this flag you can pass undefined to an optional property and not be told. Which is why the
       optional props in this project are declared explicitly as `?: T | undefined`. */
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
